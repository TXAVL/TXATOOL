<Window x:Class="TXATOOL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TXATOOL"
        xmlns:components="clr-namespace:TXATOOL.Views.Components"
        mc:Ignorable="d"
        Title="TXATOOL - WIN" Height="850" Width="1440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        Icon="Images/icon.ico"
        FontSize="15"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderThickness="2" BorderBrush="Transparent" x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="true">
                            <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
<Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ActionBrush}"/>
</Trigger>
<Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#30FFFFFF" Offset="0"/>
                                            <GradientStop Color="#30D9480F" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#50FFFFFF" Offset="0"/>
                                            <GradientStop Color="#50D9480F" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="NavGroupHeaderButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hdr" Background="Transparent" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Margin="10,10,10,0" Padding="20,5,12,5">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hdr" Property="Background" Value="{DynamicResource PanelHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Hdr" Property="BorderBrush" Value="{DynamicResource ActionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



    </Window.Resources>

    <Border CornerRadius="15" ClipToBounds="True" MouseDown="Border_MouseDown" Background="{DynamicResource BgWindowBrush}">
        <Grid>

            <!-- Main Scaling Container -->
            <Viewbox Stretch="Uniform">
                <Grid Width="1600" Height="900">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/> <!-- Header -->
                        <RowDefinition Height="*"/>   <!-- Content -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/> <!-- Sidebar -->
                        <ColumnDefinition Width="*"/>   <!-- Main Content -->
                        <ColumnDefinition Width="240"/> <!-- Description Panel -->
                    </Grid.ColumnDefinitions>

                    <!-- HEADER -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
                         <!-- App icon -->
                         <Image Source="pack://application:,,,/Images/txatool.png" Width="38" Height="38" Margin="0,0,10,0" VerticalAlignment="Center"/>
                         <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TXATOOL - WIN" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,0"/>
                         </StackPanel>
                    </StackPanel>

                    <!-- Search Bar -->
                    <Border x:Name="SearchContainer" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Width="300" Height="36" CornerRadius="18" Background="{DynamicResource PanelBrush}" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="15,0">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                            <TextBox x:Name="SearchBox" AutomationProperties.Name="Search" Text="Type here to search..." Background="Transparent" BorderThickness="0" 
                                     VerticalAlignment="Center" Margin="10,0,0,0" Width="220" Foreground="{DynamicResource TextSecondaryBrush}" 
                                     CaretBrush="{DynamicResource TextBrush}"
                                     GotFocus="SearchBox_GotFocus"
                                     LostFocus="SearchBox_LostFocus"
                                     TextChanged="SearchBox_TextChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Header Controls (Right) -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,25,0">
                        <Button x:Name="RestartButton" Content="Restart to apply changes" Height="42" Margin="0,0,15,0" Padding="30,0" Click="GlobalRestart_Click" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border BorderThickness="2" BorderBrush="Transparent" x:Name="border" Background="{TemplateBinding Background}" CornerRadius="21" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ContentPresenter TextElement.FontSize="17" TextElement.FontWeight="Medium" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ActionBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                        <GradientStop Color="#30FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#30D9480F" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Trigger>
                                     </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                             <Button.Style>
                                <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="SettingsButton" AutomationProperties.Name="Settings" ToolTip="Settings" Content="&#xF8B0;" FontFamily="Segoe MDL2 Assets" Click="SettingsButton_Click" Style="{StaticResource WindowControlButtonStyle}" Margin="5,0"/>
                        <Button x:Name="MinimizeButton" AutomationProperties.Name="Minimize" ToolTip="Minimize" Content="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="MinimizeButton_Click" Style="{StaticResource WindowControlButtonStyle}" FontSize="14" Margin="5,0"/>
                        <Button x:Name="CloseButton" AutomationProperties.Name="Close" ToolTip="Close" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="CloseButton_Click" Style="{StaticResource WindowControlButtonStyle}" FontSize="14" Margin="5,0"/>
                    </StackPanel>

                    <!-- SIDEBAR -->
                    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="15" Margin="15,20,5,20" Padding="0,10">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,0">
                            <StackPanel>
                                <RadioButton GroupName="MainNav" x:Name="NavDashboard" IsChecked="True" Content="Dashboard" Tag="&#xE80F;" Style="{StaticResource MenuButtonStyle}" Checked="Dashboard_Checked" Click="NavDashboard_Click"/>
                                
                                <!-- GROUP 1: OS DEPLOYMENT & SETUP -->
                                <Button Style="{StaticResource NavGroupHeaderButtonStyle}" Click="NavGroup_Click" Tag="GroupDeploy" AutomationProperties.Name="NavGroupDeploy">
                                    <Grid>
                                        <TextBlock x:Name="NavGroupDeploy" Text="OS Deployment" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="ChvDeploy" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="GroupDeploy">
                                    <RadioButton GroupName="MainNav" x:Name="NavWSAP" Content="WSAP" Tag="&#xE74C;" Style="{StaticResource MenuButtonStyle}" Checked="WSAP_Checked"/>
                                    <RadioButton GroupName="MainNav" x:Name="NavUSBBoot" Content="USB Boot" Tag="&#xE88E;" Style="{StaticResource MenuButtonStyle}" Checked="USBBoot_Checked"/>
                                    <RadioButton GroupName="MainNav" x:Name="NavConvertSKU" Content="Convert SKUs" Tag="&#xE8B1;" Style="{StaticResource MenuButtonStyle}" Checked="ConvertSKU_Checked"/>
                                    <RadioButton GroupName="MainNav" x:Name="NavLicense" Content="License" Tag="&#xE8D7;" Style="{StaticResource MenuButtonStyle}" Checked="License_Checked"/>
                                </StackPanel>

                                <!-- GROUP 2: SYSTEM OPTIMIZATION -->
                                <Button Style="{StaticResource NavGroupHeaderButtonStyle}" Click="NavGroup_Click" Tag="GroupOptimize" AutomationProperties.Name="NavGroupOptimize">
                                    <Grid>
                                        <TextBlock x:Name="NavGroupOptimize" Text="System Optimization" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="ChvOptimize" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="GroupOptimize">
                                    <RadioButton GroupName="MainNav" x:Name="NavGeneral" Content="General" Tag="&#xF8B0;" Style="{StaticResource MenuButtonStyle}" Checked="General_Checked"/>
                                    <RadioButton GroupName="MainNav" x:Name="NavWindows" Content="Windows" Tag="&#xE7F4;" Style="{StaticResource MenuButtonStyle}" Checked="Windows_Checked"/>
                                    <RadioButton GroupName="MainNav" x:Name="NavStartup" Content="Startup Apps" Tag="&#xEC4A;" Style="{StaticResource MenuButtonStyle}" Checked="Startup_Checked"/>
                                    <RadioButton GroupName="MainNav" x:Name="NavUWPApps" Content="UWP Apps" Tag="&#xE71D;" Style="{StaticResource MenuButtonStyle}" Checked="UWPApps_Checked"/>
                                    <RadioButton GroupName="MainNav" x:Name="NavCleaning" Content="Cleaning" Tag="&#xE74D;" Style="{StaticResource MenuButtonStyle}" Checked="Cleaning_Checked"/>
                                </StackPanel>

                                <!-- GROUP 3: SOFTWARE & TOOLS -->
                                <Button Style="{StaticResource NavGroupHeaderButtonStyle}" Click="NavGroup_Click" Tag="GroupSoftware" AutomationProperties.Name="NavGroupSoftware">
                                    <Grid>
                                        <TextBlock x:Name="NavGroupSoftware" Text="Software &amp; Tools" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="ChvSoftware" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="GroupSoftware">
                                    <RadioButton GroupName="MainNav" x:Name="NavDownload" Content="Download" Tag="&#xE896;" Style="{StaticResource MenuButtonStyle}" Checked="Download_Checked"/>
                                    <RadioButton GroupName="MainNav" x:Name="NavOffice" Content="Office" Tag="&#xE9F9;" Style="{StaticResource MenuButtonStyle}" Checked="Office_Checked"/>
                                    <RadioButton GroupName="MainNav" x:Name="NavExtendFeatures" Content="Extend Features" Tag="&#xE700;" Style="{StaticResource MenuButtonStyle}" Checked="ExtendFeatures_Checked"/>
                                </StackPanel>

                                <!-- GROUP 4: DIAGNOSTICS & REPAIR -->
                                <Button Style="{StaticResource NavGroupHeaderButtonStyle}" Click="NavGroup_Click" Tag="GroupDiagnostics" AutomationProperties.Name="NavGroupDiagnostics">
                                    <Grid>
                                        <TextBlock x:Name="NavGroupDiagnostics" Text="Diagnostics &amp; Repair" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="ChvDiagnostics" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="GroupDiagnostics">
                                    <RadioButton GroupName="MainNav" x:Name="NavHardware" Content="Hardware Info" Tag="&#xE946;" Style="{StaticResource MenuButtonStyle}" Checked="HardwareInfo_Checked"/>
                                    <RadioButton GroupName="MainNav" x:Name="NavNetwork" Content="Network" Tag="&#xE909;" Style="{StaticResource MenuButtonStyle}" Checked="Network_Checked"/>
                                    <RadioButton GroupName="MainNav" x:Name="NavPrinterErrors" Content="Printer Errors" Tag="&#xF56D;" Style="{StaticResource MenuButtonStyle}" Checked="PrinterErrors_Checked"/>
                                    <RadioButton GroupName="MainNav" x:Name="NavWindowsErrors" Content="Windows Errors" Tag="&#xED15;" Style="{StaticResource MenuButtonStyle}" Checked="WindowsErrors_Checked"/>
                                    <RadioButton GroupName="MainNav" x:Name="NavFixGame" Content="Fix game errors" Tag="&#xE90F;" Style="{StaticResource MenuButtonStyle}" Checked="FixGameErrors_Checked" Visibility="Visible"/>
                                    <RadioButton GroupName="MainNav" x:Name="NavGameConfigs" Content="Game Configs" Tag="&#xE7FC;" Style="{StaticResource MenuButtonStyle}" Checked="GameConfigs_Checked" Visibility="Visible"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- MAIN CONTENT BACKGROUND (GLASS LAYERS) -->
                    <Border x:Name="MainBackgroundBorder" Grid.Row="1" Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="15" Margin="20,20,10,20"/>
                    
                    <!-- MAIN CONTENT AREA -->
                    <ContentControl x:Name="MainContentControl" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="20,20,20,20" FocusVisualStyle="{x:Null}"/>

                    <!-- RIGHT DESCRIPTION PANEL -->
                    <Border x:Name="RightPanelBorder" Grid.Row="1" Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="15" Margin="10,20,20,20" Padding="15">
                         <ContentControl x:Name="RightPanelContent"/>
                    </Border>



                </Grid>
            </Viewbox>
            <!-- Global Loading Overlay -->
            <components:LoadingOverlayView x:Name="GlobalLoadingOverlay" Visibility="Collapsed" Panel.ZIndex="1000"/>
        </Grid>
    </Border>
</Window>
