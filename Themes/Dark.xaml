<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DARK THEME: warm stone-black ground, raised stone surfaces, same orange accent family. -->

    <LinearGradientBrush x:Key="BgWindowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#171412" Offset="0"/>
        <GradientStop Color="#0F0D0C" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PanelBrush" Color="#B31F1B19"/>
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#CC2A2522"/>
    <SolidColorBrush x:Key="PanelSelectedBrush" Color="#E6332D29"/>

    <SolidColorBrush x:Key="SurfaceBrush" Color="#292422"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#221E1C"/>
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#1A1716"/>
    <SolidColorBrush x:Key="LineBrush" Color="#3F3935"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#5A524C"/>

    <SolidColorBrush x:Key="TextBrush" Color="#F5F2EE"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D6D0C9"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A59D95"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <Color x:Key="ActionColor">#D9480F</Color>
    <SolidColorBrush x:Key="ActionBrush" Color="#D9480F"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F0601F"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FB923C"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3A2418"/>
    <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#4A2D1D"/>
    <SolidColorBrush x:Key="AccentSoftPressedBrush" Color="#5C3823"/>
</ResourceDictionary>
