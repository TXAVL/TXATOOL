<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- LIGHT THEME: warm stone ground, white content surfaces, burnt-orange accent.
         Keep key names identical to Dark.xaml. -->

    <LinearGradientBrush x:Key="BgWindowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F6F3EF" Offset="0"/>
        <GradientStop Color="#E9E3DB" Offset="1"/>
    </LinearGradientBrush>

    <!-- Panes (sidebar, main, description): translucent over the ground -->
    <SolidColorBrush x:Key="PanelBrush" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="PanelSelectedBrush" Color="#E6FFFFFF"/>

    <!-- Content surfaces on top of panes -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FAF8F6"/>
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#EFEBE6"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E3DDD5"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#C9C1B7"/>

    <SolidColorBrush x:Key="TextBrush" Color="#1C1917"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#44403C"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B645D"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Orange family. ActionBrush: solid fills with white text, icons. AccentTextBrush: orange text on surface. -->
    <Color x:Key="ActionColor">#C2410C</Color>
    <SolidColorBrush x:Key="ActionBrush" Color="#C2410C"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9A3412"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#C2410C"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFF1E7"/>
    <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#FFE1CC"/>
    <SolidColorBrush x:Key="AccentSoftPressedBrush" Color="#FDCFAE"/>
</ResourceDictionary>
