<Window x:Class="TXATOOL.Views.Components.LicenseBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lưu thông tin bản quyền"
        Width="500" Height="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Foreground="{DynamicResource TextBrush}">
    
    <Grid>
        <!-- Bóng mờ viền ngoài -->
        <Border Margin="10" Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
            </Border.Effect>
        </Border>
        
        <!-- Nội dung chính -->
        <Border Margin="10" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="&#xF67F;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" FontSize="20" Foreground="{DynamicResource ActionBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblPopupBackupTitle" Text="Lưu thông tin bản quyền" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- 2. Subtitle -->
                <TextBlock x:Name="lblPopupBackupSubTitle" Grid.Row="1" Text="Chọn vị trí để lưu thư mục sao lưu:" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,15"/>
                
                <!-- 3. Option 1: Default Path -->
                <StackPanel Grid.Row="2" Margin="0,0,0,25">
                    <RadioButton x:Name="rbDefaultPath" GroupName="BackupPathGroup" Content="Lưu ở vị trí mặc định" Style="{DynamicResource ModernRadioButtonStyle}" IsChecked="True" FontSize="14" Foreground="{DynamicResource TextBrush}" FontWeight="Medium" Margin="0,0,0,8" Checked="Radio_Checked" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="txtDefaultPath" Text="Đường dẫn: D:\Documents\TXATOOL_Backup" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="22,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                
                <!-- 4. Option 2: Custom Path -->
                <StackPanel Grid.Row="3">
                    <RadioButton x:Name="rbCustomPath" GroupName="BackupPathGroup" Content="Chọn vị trí khác" Style="{DynamicResource ModernRadioButtonStyle}" FontSize="14" Foreground="{DynamicResource ActionBrush}" FontWeight="Medium" Margin="0,0,0,12" Checked="Radio_Checked" VerticalContentAlignment="Center"/>
                    
                    <Grid Margin="22,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,10,0">
                            <TextBox x:Name="tbCustomPath" IsEnabled="False" Text="" Background="Transparent" BorderThickness="0" Padding="10,8" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                        </Border>
                        
                        <Button x:Name="btnBrowse" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="15,8" Foreground="{DynamicResource TextBrush}" IsEnabled="False" Click="Browse_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" Margin="0,0,6,0" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblPopupBackupBrowse" Text="Duyệt thư mục..." VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
                
                <!-- 5. Footer Buttons -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="btnBackup" Content="Sao lưu" Background="{DynamicResource ActionBrush}" Foreground="White" BorderThickness="0" Padding="25,8" Margin="0,0,10,0" FontWeight="SemiBold" Cursor="Hand" Click="BtnBackup_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="btnCancel" Content="Hủy" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="25,8" Cursor="Hand" Click="BtnCancel_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
