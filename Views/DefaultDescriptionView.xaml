<UserControl x:Class="TXATOOL.Views.DefaultDescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="240"
             Foreground="{DynamicResource TextBrush}">
    <StackPanel>
        <StackPanel x:Name="EnglishPanel">
            <TextBlock Text="Description:" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
            <TextBlock Text="In this option, you can optimize the overall performance, which means you will experience a boost in your computer's speed. Additionally, you can improve your privacy by turning off certain Microsoft tracking services." 
                       TextWrapping="Wrap" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <StackPanel x:Name="VietnamesePanel">
            <TextBlock Text="Mô tả:" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
            <TextBlock Text="Với tùy chọn này, bạn có thể tối ưu hóa hiệu suất tổng thể, giúp cải thiện tốc độ xử lý của máy tính. Ngoài ra, bạn có thể tăng cường quyền riêng tư bằng cách vô hiệu hóa các dịch vụ thu thập dữ liệu ngầm của Microsoft." 
                       TextWrapping="Wrap" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
