<UserControl x:Class="TXATOOL.Views.ExtendFeaturesDescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="240"
             Foreground="{DynamicResource TextBrush}">
    <StackPanel>
        <StackPanel x:Name="EnglishPanel">
            <TextBlock Text="Description:" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Expand your Windows toolkit with powerful extra utilities: add Take Ownership or God Mode to right-click menu, export/import drivers, download Intel IRST drivers, and backup Wi-Fi passwords." 
                       TextWrapping="Wrap" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <StackPanel x:Name="VietnamesePanel">
            <TextBlock Text="Mô tả:" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Mở rộng bộ công cụ Windows với các tiện ích thiết thực: thêm menu chuột phải Take Ownership, God Mode, End Task; sao lưu &amp; phục hồi Driver; tải driver Intel IRST nhận diện ổ cứng; xuất mật khẩu Wi-Fi." 
                       TextWrapping="Wrap" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
