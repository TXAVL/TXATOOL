<UserControl x:Class="TXATOOL.Views.FixGameErrorsDescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="240"
             Foreground="{DynamicResource TextBrush}">
    <StackPanel>
        <StackPanel x:Name="EnglishPanel">
            <TextBlock Text="Description:" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Remove the most frequent errors that interrupt your gaming experience. Easily resolves missing DirectX, Visual C++ runtimes, and game launch crashes." 
                       TextWrapping="Wrap" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <StackPanel x:Name="VietnamesePanel">
            <TextBlock Text="Mô tả:" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Khắc phục các lỗi phổ biến khi chơi game: thiếu thư viện DirectX, Visual C++ Redistributable, xung đột DLL và lỗi crash khi mở game." 
                       TextWrapping="Wrap" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
