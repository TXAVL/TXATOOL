<UserControl x:Class="TXATOOL.Views.NetworkDescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="240"
             Foreground="{DynamicResource TextBrush}">
    <StackPanel>
        <StackPanel x:Name="EnglishPanel">
            <TextBlock Text="Description:" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Quick network diagnostics and configuration: switch to fast public DNS servers (Google, Cloudflare, Quad9), flush DNS cache, reset Winsock/IP stack, and test latency." 
                       TextWrapping="Wrap" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <StackPanel x:Name="VietnamesePanel">
            <TextBlock Text="Mô tả:" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Công cụ chẩn đoán và cấu hình mạng nhanh chóng: đổi nhanh DNS (Google DNS, Cloudflare, Quad9), xóa bộ nhớ cache DNS, reset Winsock và cấu hình IP khi mạng bị lỗi." 
                       TextWrapping="Wrap" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
