<Window x:Class="TXATOOL.Views.USBBootProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="USB Boot Creation Progress" Height="200" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        Background="Transparent" AllowsTransparency="True"
        Foreground="{DynamicResource TextBrush}">
    
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="15" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
            <TextBlock Text="Processing..." x:Name="TxtTitle" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <ProgressBar x:Name="PbStatus" IsIndeterminate="True" Height="10" Width="300" Margin="0,0,0,15" Foreground="{DynamicResource AccentTextBrush}" Background="{DynamicResource SurfaceSunkenBrush}" BorderThickness="0"/>
            
            <TextBlock x:Name="TxtStatus" Text="Initializing..." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
