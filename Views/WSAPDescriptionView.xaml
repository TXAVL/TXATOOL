<UserControl x:Class="TXATOOL.Views.WSAPDescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="240"
             Foreground="{DynamicResource TextBrush}">
    <StackPanel>
        <StackPanel x:Name="EnglishPanel">
            <TextBlock Text="Description:" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Windows Setup Automatic Protocol (WSAP) lets you install or reinstall Windows automatically, right from your PC.&#x0a;&#x0a;No USB required, no complicated steps — just a smooth, guided process. Fast, simple, and reliable." 
                       TextWrapping="Wrap" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <StackPanel x:Name="VietnamesePanel">
            <TextBlock Text="Mô tả:" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Windows Setup Automatic Protocol (WSAP) cho phép bạn cài đặt hoặc cài lại Windows tự động ngay từ máy tính của mình.&#x0a;&#x0a;Không cần USB, không cần thao tác phức tạp — quy trình tự động hoàn toàn, an toàn và nhanh chóng." 
                       TextWrapping="Wrap" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
